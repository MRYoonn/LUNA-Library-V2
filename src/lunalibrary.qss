/* Native presentation of the exact v0.9.1 HTML tokens; no PDF drawing rules. */
QMainWindow { background:@CANVAS@; color:@TEXT@; font-family:"Malgun Gothic","Segoe UI"; font-size:13px; }
QMainWindow::separator { background:@CANVAS@; width:7px; height:7px; }
QDockWidget#LunaLibraryDock { border:0; background:@CANVAS@; }
QWidget#LunaLibraryPanel { background:@CANVAS@; color:@TEXT@; font-family:"Malgun Gothic","Segoe UI"; font-size:13px; }
QScrollArea#LunaNavigation { background:white; border:1px solid #DCE6F2; border-radius:12px; }
QWidget#LunaNavigationContents, QWidget#LunaNavigationViewport { background:transparent; border:0; }
QWidget#LunaDocuments { background:white; border:1px solid #DCE6F2; border-radius:12px; }
QWidget#LunaPdfFrame { background:@CANVAS@; border:0; }
QLabel#LunaBrand { color:@NAVY@; font-family:"Malgun Gothic"; font-size:20px; font-weight:700; background:transparent; }
QLabel#LunaSection { color:#29466C; font-size:14px; font-weight:600; }
QLabel#LunaSecondary { color:@MUTED@; font-size:11px; }
QLabel#LunaLibraryTitle { color:@NAVY@; font-family:"Malgun Gothic"; font-size:18px; font-weight:700; background:transparent; }
QToolButton#LunaListViewMode, QToolButton#LunaCardViewMode { background:white; border:1px solid transparent; border-radius:7px; padding:3px; }
QToolButton#LunaListViewMode:hover, QToolButton#LunaCardViewMode:hover { background:#E9F1FE; }
QToolButton#LunaListViewMode:checked, QToolButton#LunaCardViewMode:checked { background:#E3EFFF; border:1px solid #D6E6FF; }
QLabel#LunaCount { color:@MUTED@; }
QPushButton[lunaNavigation="true"] { text-align:left; padding:6px 35px 6px 9px; border:0; border-radius:6px; color:#33496B; background:transparent; }
QPushButton[lunaNavigation="true"]:hover { background:#F0F5FD; }
QPushButton[lunaNavigation="true"]:checked { background:#E2EFFF; color:#174CA5; }
QPushButton#LunaPrimary, QPushButton#LunaLocation, QToolButton#LunaTool { background:white; color:#2F5C9C; border:1px solid #DFE7F1; border-radius:7px; padding:3px; }
QPushButton#LunaPrimary:hover, QPushButton#LunaLocation:hover, QToolButton#LunaTool:hover { background:#EAF2FF; }
QLineEdit#LunaSearch, QLineEdit#LunaGlobalSearch { background:white; color:@TEXT@; border:1px solid #D6E0ED; border-radius:8px; padding:7px 9px; }
QLineEdit#LunaSearch:focus, QLineEdit#LunaGlobalSearch:focus { border:1px solid @BLUE@; }
QWidget#LunaLibraryPanel QTreeView { background:transparent; border:0; outline:0; color:#33496B; }
QWidget#LunaLibraryPanel QTreeView::item { min-height:24px; padding:5px 0; border-radius:6px; }
QWidget#LunaLibraryPanel QTreeView::item:hover { background:#F0F5FD; }
QWidget#LunaLibraryPanel QTreeView::item:selected { background:#E2EFFF; color:#174CA5; }
QListWidget#LunaDocumentList { background:white; border:0; outline:0; }
QLineEdit#LunaPaperMemoEditor { background:white; color:#234269; border:1px solid #83A9DF; border-radius:5px; padding:1px 4px; font-size:12px; }
QSplitter#LunaLibrarySplitter::handle { background:@CANVAS@; }
/* MenuBarStyle owns the 48px menu/brand row, including item hit rectangles.
   Styling ::item here makes QStyleSheetStyle bypass that native sizing and
   paints its text at the top. Dropdown menus remain styled independently. */
QMenu { background:#F8FBFF; color:@TEXT@; border:1px solid #D5E0EF; border-radius:9px; padding:5px; }
QMenu::item { padding:7px 22px 7px 25px; border-radius:5px; }
QMenu::item:selected { background:#E7EFFF; color:#174CA5; }
QMenu::item:disabled { color:#9CAAC0; }
QMenu::separator { background:@LINE@; height:1px; margin:4px 8px; }
QWidget#LunaBrandFrame { background:transparent; border:0; }
QToolBar#LunaLibraryToolbar { background:@CANVAS@; border:0; }
QToolBar#mainToolBar { border:0; border-bottom:1px solid @LINE@; background:white; spacing:2px; padding:3px 4px; }
QToolBar#mainToolBar QToolButton { border:0; border-radius:7px; padding:4px; min-width:22px; min-height:24px; }
QToolBar#mainToolBar QToolButton:hover { background:#E9F1FE; }
QToolBar#mainToolBar QToolButton:checked { background:#E3EFFF; }
QToolBar#mainToolBar QAbstractSpinBox { background:white; color:@TEXT@; border:1px solid #D9E4F2; border-radius:7px; min-height:24px; }
QToolBar#mainToolBar::separator { background:@LINE@; width:1px; margin:7px 3px; }
QToolBar#LunaCommonReaderToolbar { background:white; border:0; border-bottom:1px solid @LINE@; spacing:5px; padding:0 13px; }
QToolBar#LunaCommonReaderToolbar QToolButton { border:0; border-radius:7px; padding:0 7px; min-width:21px; min-height:34px; }
QToolBar#LunaCommonReaderToolbar QToolButton:hover { background:#E9F1FE; }
QToolBar#LunaCommonReaderToolbar QToolButton:checked { background:#E3EFFF; }
QToolBar#LunaCommonReaderToolbar QAbstractSpinBox, QToolBar#LunaCommonReaderToolbar QComboBox { background:white; color:#263D63; border:1px solid #D9E4F2; border-radius:7px; min-height:30px; padding:0 3px; }
QToolBar#LunaCommonReaderToolbar QAbstractSpinBox QLineEdit { color:#263D63; background:transparent; border:0; padding:0; min-height:0; }
QToolBar#LunaCommonReaderToolbar QComboBox:disabled, QToolBar#LunaCommonReaderToolbar QAbstractSpinBox:disabled { color:#9CAAC0; background:#F8FAFD; }
QToolBar#LunaCommonReaderToolbar QComboBox::drop-down { border:0; width:17px; }
QToolBar#LunaCommonReaderToolbar::separator { background:#DCE5EF; width:1px; margin:13px 9px; }
QTabBar#LunaContentModes { background:#F8FAFF; }
QTabBar#LunaContentModes::tab { background:#F8FAFF; color:#637B9C; border:1px solid transparent; border-radius:7px; margin:5px 3px; padding:7px 4px; font-size:12px; }
QTabBar#LunaContentModes::tab:hover { background:#EFF5FF; }
QTabBar#LunaContentModes::tab:selected { color:#225BB1; background:#E8F0FF; border:1px solid #D3E3FB; font-weight:700; }
QListView#LunaPageGrid { background:white; border:0; padding:0; }
QListView#LunaPageGrid::item { border:1px solid transparent; border-radius:10px; margin:4px; padding:4px; }
QListView#LunaPageGrid::item:hover { background:#F4F8FF; border:1px solid #D5E3F8; }
QListView#LunaPageGrid::item:selected { background:#E9F1FF; border:1px solid #77A7EA; }
QToolButton#LunaCombinedPanelToggle { color:#2F5C9C; background:white; border:1px solid #DFE7F1; border-radius:7px; padding:3px; }
QToolButton#LunaCombinedPanelToggle:hover { background:#EAF2FF; }
QTabWidget#LunaPdfTabs::pane { border:1px solid #DCE6F2; border-top:0; border-bottom-left-radius:12px; border-bottom-right-radius:12px; background:#DFE5ED; }
QTabBar#LunaPdfTabBar { background:#F3F6FB; border-bottom:1px solid #D6E2F1; }
QTabBar#LunaPdfTabBar::tab { background:#EDF2F9; color:#657794; font-size:12px; border:0; border-right:1px solid #DBE5F1; border-bottom:3px solid transparent; border-top-left-radius:9px; border-top-right-radius:9px; padding:0 8px 0 12px; }
QTabBar#LunaPdfTabBar::tab:hover { background:#F6F9FF; }
QTabBar#LunaPdfTabBar::tab:selected { background:white; color:#14396C; border-bottom:3px solid #4F84DC; }
QToolButton#LunaCloseTab, QToolButton#LunaNewTab { background:transparent; color:#71809A; border:0; border-radius:4px; padding:0; }
QToolButton#LunaCloseTab:hover, QToolButton#LunaNewTab:hover { background:#E5ECF5; }
QToolButton#LunaCloseTab:disabled { color:#B7C3D4; }
QScrollBar:vertical { background:#F3F6FB; width:15px; margin:0; }
QScrollBar::handle:vertical { background:#B9C6D8; border-radius:4px; min-height:25px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background:transparent; }

QLabel#LunaNavigationCount { color:#8693A8; font-size:12px; background:transparent; }
