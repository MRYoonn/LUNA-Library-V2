/* LUNA light theme. @TOKENS@ are expanded from the shared C++ palette. */
QWidget#LunaLibraryPanel { background:@CANVAS@; color:@TEXT@; font-family:"Segoe UI","Malgun Gothic"; font-size:13px; }
QWidget#LunaNavigation, QWidget#LunaNavigationContents { background:@CANVAS@; border-right:1px solid @LINE@; }
QWidget#LunaDocuments { background:@PANEL@; border-right:1px solid @LINE@; }
QLabel#LunaBrand { color:#172B50; font-family:"Malgun Gothic"; font-size:20px; font-weight:700; }
QLabel#LunaSection { color:@MUTED@; font-size:12px; font-weight:600; }
QLabel#LunaSecondary { color:@MUTED@; font-size:11px; }
QLabel#LunaLibraryTitle { color:#172B50; font-family:"Malgun Gothic"; font-size:17px; font-weight:700; }
QLabel#LunaActiveMode { color:@BLUE@; font-weight:600; padding:10px 0; border-bottom:2px solid @BLUE@; }
QLabel#LunaCount { color:@MUTED@; background:@PANEL@; padding:9px 18px; border-top:1px solid @LINE@; border-bottom:1px solid @LINE@; }
QPushButton[lunaNavigation="true"] { text-align:left; padding:5px 10px; border:0; border-radius:8px; color:@TEXT@; background:transparent; }
QPushButton[lunaNavigation="true"]:hover { background:@HOVER@; }
QPushButton[lunaNavigation="true"]:checked { background:@SELECTION@; color:@ACTIVE_TEXT@; font-weight:600; }
QPushButton#LunaPrimary { background:@BLUE@; color:white; border:1px solid @BLUE@; border-radius:8px; font-weight:600; padding:5px 12px; }
QPushButton#LunaPrimary:hover { background:@BLUE_HOVER@; }
QPushButton#LunaLocation { text-align:left; background:white; color:@BLUE@; border:1px solid @LINE@; border-radius:6px; padding:8px; }
QToolButton#LunaTool { background:transparent; color:@MUTED@; border:0; border-radius:5px; padding:4px; }
QToolButton#LunaTool:hover { background:@SELECTION@; }
QLineEdit#LunaSearch, QLineEdit#LunaGlobalSearch { background:white; color:@TEXT@; border:1px solid @LINE@; border-radius:7px; padding:5px 9px; }
QLineEdit#LunaSearch:focus, QLineEdit#LunaGlobalSearch:focus { border:1px solid @BLUE@; }
QWidget#LunaLibraryPanel QTreeView { background:transparent; border:0; outline:0; color:@TEXT@; }
QWidget#LunaLibraryPanel QTreeView::item { padding:7px 0; border-radius:5px; }
QWidget#LunaLibraryPanel QTreeView::item:selected { background:@SELECTION@; color:@ACTIVE_TEXT@; }
QListWidget#LunaDocumentList { background:white; border:0; outline:0; }
QWidget#LunaLibraryPanel QProgressBar { border:0; background:@LINE@; border-radius:3px; }
QWidget#LunaLibraryPanel QProgressBar::chunk { background:@BLUE@; border-radius:3px; }
QSplitter#LunaLibrarySplitter::handle { background:@LINE@; }
QToolBar#LunaLibraryToolbar { background:@CANVAS@; border:0; border-bottom:1px solid @LINE@; padding:5px 10px; spacing:5px; }
QToolBar#LunaLibraryToolbar QToolButton { border:0; border-radius:6px; padding:7px 10px; color:@TEXT@; }
QToolBar#LunaLibraryToolbar QToolButton:checked { background:@SELECTION@; color:@ACTIVE_TEXT@; }
QToolBar#mainToolBar { border:0; border-bottom:1px solid @LINE@; background:@PANEL@; spacing:2px; padding:3px 4px; }
QToolBar#mainToolBar QToolButton { border:0; border-radius:5px; padding:4px; min-width:22px; min-height:24px; }
QToolBar#mainToolBar QToolButton:hover { background:@HOVER@; }
QToolBar#mainToolBar QToolButton:checked { background:@SELECTION@; }
QToolBar#mainToolBar QToolButton:disabled { color:@MUTED@; }
QToolBar#mainToolBar QAbstractSpinBox { background:@CANVAS@; color:@TEXT@; border:1px solid @LINE@; border-radius:5px; min-height:24px; }
QToolBar#mainToolBar::separator { background:@LINE@; width:1px; margin:7px 3px; }
QMenuBar { background:@CANVAS@; color:@TEXT@; font-size:13px; padding:2px 6px; }
QMenuBar::item { padding:5px 8px; border-radius:4px; }
QMenuBar::item:selected { background:@SELECTION@; }
QWidget#LunaDocumentHeader { background:@CANVAS@; border-bottom:1px solid @LINE@; }
QLabel#LunaDocumentTitle { color:@NAVY@; font-weight:600; }
QToolBar#LunaViewModes { background:transparent; border:0; spacing:3px; }
QToolBar#LunaViewModes QToolButton { border:0; border-radius:5px; padding:6px; color:@TEXT@; }
QToolBar#LunaViewModes QToolButton:checked { background:@SELECTION@; color:@ACTIVE_TEXT@; }

QTabBar#LunaContentModes::tab { background:@PANEL@; color:@MUTED@; border:0; border-bottom:2px solid @LINE@; padding:8px 12px; }
QTabBar#LunaContentModes::tab:selected { color:@BLUE@; border-bottom:2px solid @BLUE@; }
QListView#LunaPageGrid { background:@PANEL@; border:0; padding:0; }
QListView#LunaPageGrid::item { border:1px solid @LINE@; border-radius:5px; margin:4px; padding:4px; }
QListView#LunaPageGrid::item:selected { background:@SELECTION@; border:1px solid @BLUE@; }
QToolButton#LunaCombinedPanelToggle { color:@BLUE@; background:@PANEL@; border:1px solid @LINE@; border-radius:5px; font-size:18px; }

QTabWidget#LunaPdfTabs::pane { border: 0; background: @PANEL@; }
QTabBar#LunaPdfTabBar { background:@CANVAS@; }
QTabBar#LunaPdfTabBar::tab { background:@CANVAS@; color:@TEXT@; font-size:12px; border:1px solid @LINE@; border-bottom:2px solid @LINE@; padding:5px 8px; min-width:68px; }
QTabBar#LunaPdfTabBar::tab:hover { background:@HOVER@; }
QTabBar#LunaPdfTabBar::tab:selected { background:@PANEL@; color:@NAVY@; border-bottom:2px solid @BLUE@; font-weight:600; }
